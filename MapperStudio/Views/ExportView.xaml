<UserControl x:Class="MapperStudio.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Export" Style="{StaticResource HeadingTextStyle}" />
            <TextBlock Text="Review and export mapping as JSON" Style="{StaticResource SubtleTextStyle}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Mapping Summary" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Title" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding MappingTitle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Source System" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding SourceSystem}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Target System" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding TargetSystem}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Mapped Fields" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding MappedFieldCount}" />
                    </StackPanel>
                    <Button Content="Export Mapping as JSON"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ExportCommand}"
                            IsEnabled="{Binding CanExport}" />
                    <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource SubtleTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="JSON Preview" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />
                    <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding JsonPreview}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="400" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
