<UserControl x:Class="MapperStudio.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mapping Studio" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,16,0" />
                <TextBlock Text="Setup" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
                <TextBlock Text=">" Style="{StaticResource SubtleTextStyle}" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Text="Map Fields" Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Draft" Style="{StaticResource GhostButtonStyle}" Margin="0,0,12,0" />
                <Button Content="Next: Map Fields" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NextCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Mapping Title" Style="{StaticResource InputLabelStyle}" />
                    <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding MappingTitle, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Text="Direction" Style="{StaticResource InputLabelStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="Inbound" Style="{StaticResource SegmentButtonStyle}" IsChecked="True" Margin="0,0,8,0" />
                        <ToggleButton Content="Outbound" Style="{StaticResource SegmentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Description (Optional)" Style="{StaticResource InputLabelStyle}" />
                    <TextBox Style="{StaticResource WatermarkTextBoxStyle}" Tag="Internal tracking description..." Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                        <TextBlock Text="Source Definition" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Style="{StaticResource TagPillStyle}" Margin="12,0,0,0">
                            <TextBlock Text="ONLINE" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Connector Type" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox ItemsSource="{Binding SystemTypes}" SelectedItem="{Binding SelectedSourceSystem}" Margin="0,0,0,12" />
                    <TextBlock Text="Endpoint URL" Style="{StaticResource InputLabelStyle}" />
                    <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="https://api.enterprise.com/v1/users/schema" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                        <TextBlock Text="Authentication" Style="{StaticResource InputLabelStyle}" />
                        <TextBlock Text="Add Header" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceAltBrush}">
                        <StackPanel>
                            <TextBlock Text="Bearer token_live_823hdj..." Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                            <TextBlock Text="X-Tenant-ID: US-PROD-01" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Source Schema" Style="{StaticResource InputLabelStyle}" Margin="0,16,0,6" />
                    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceAltBrush}">
                        <StackPanel>
                            <TextBlock Text="user" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="id" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,4" />
                            <TextBlock Text="name" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,4" />
                            <TextBlock Text="email" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,4" />
                            <TextBlock Text="preferences" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,4" />
                            <TextBlock Text="timestamp" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,4" />
                            <TextBlock Text="version" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="Call API & Load Schema" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" Command="{Binding LoadSourceSchemaCommand}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                        <TextBlock Text="Target Definition" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Style="{StaticResource TagPillStyle}" Margin="12,0,0,0">
                            <TextBlock Text="DATAVERSE" Foreground="{StaticResource InfoBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Target Type" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox ItemsSource="{Binding SystemTypes}" SelectedItem="{Binding SelectedTargetSystem}" Margin="0,0,0,12" />
                    <TextBlock Text="Entity / File" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox ItemsSource="{Binding EntityOptions}" SelectedItem="{Binding SelectedEntity}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                        <TextBlock Text="Target Columns" Style="{StaticResource InputLabelStyle}" />
                        <TextBlock Text="6 Columns Detected" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding TargetColumns}" AutoGenerateColumns="False" HeadersVisibility="Column" Height="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Data Type" Binding="{Binding DataType}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Req" Binding="{Binding Required}" Width="60" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Read Headers" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" Command="{Binding LoadTargetSchemaCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
