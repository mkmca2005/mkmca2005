<UserControl x:Class="MapperStudio.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MapperStudio.Models">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:SchemaNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
        </HierarchicalDataTemplate>
        <Style x:Key="SourceSectionStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSourceConnectionType}" Value="REST API">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SourceSqlSectionStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSourceConnectionType}" Value="SQL Server">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SourceCsvSectionStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSourceConnectionType}" Value="CSV">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TargetSectionStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTargetConnectionType}" Value="REST API">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TargetSqlSectionStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTargetConnectionType}" Value="SQL Server">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TargetCsvSectionStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTargetConnectionType}" Value="CSV">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Mapping Title" Style="{StaticResource InputLabelStyle}" />
                        <TextBlock Text="*" Foreground="{StaticResource ErrorBrush}" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBox Style="{StaticResource BaseTextBoxStyle}"
                             Text="{Binding MappingTitle, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="150" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0">
                    <TextBlock Text="Direction" Style="{StaticResource InputLabelStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="Inbound" Style="{StaticResource SegmentButtonStyle}" IsChecked="{Binding IsInbound}" Margin="0,0,8,0" />
                        <ToggleButton Content="Outbound" Style="{StaticResource SegmentButtonStyle}" IsChecked="{Binding IsOutbound}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Description (Optional)" Style="{StaticResource InputLabelStyle}" />
                    <TextBox Style="{StaticResource WatermarkTextBoxStyle}"
                             Tag="Internal tracking description..."
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinLines="2"
                             MaxLines="2"
                             MaxLength="500" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Source Definition" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Style="{StaticResource TagPillStyle}" Margin="12,0,0,0">
                            <TextBlock Text="ONLINE" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Connector Type" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding SelectedSourceConnectionType}" Margin="0,0,0,12" />

                    <StackPanel Style="{StaticResource SourceSectionStyle}">
                        <TextBlock Text="API Endpoint URL" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding SourceEndpointUrl}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Authentication" Style="{StaticResource InputLabelStyle}" />
                            <TextBlock Text="Add Header" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="Bearer Token" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding SourceBearerToken}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding SourceHeaders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.8*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding Key}" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Style="{StaticResource BaseTextBoxStyle}" Text="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Button Content="Call API &amp; Load Schema" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" Command="{Binding LoadSourceSchemaCommand}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource SourceSqlSectionStyle}">
                        <TextBlock Text="Connection String" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding SourceConnectionString}" Margin="0,0,0,12" />
                        <TextBlock Text="Table / View Name" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding SourceTableName}" Margin="0,0,0,12" />
                        <Button Content="Get Schema" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadSourceSchemaCommand}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource SourceCsvSectionStyle}">
                        <TextBlock Text="CSV File" Style="{StaticResource InputLabelStyle}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding SourceCsvPath}" Margin="0,0,12,0" />
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButtonStyle}" />
                        </Grid>
                        <Button Content="Read Headers" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadSourceSchemaCommand}" />
                    </StackPanel>

                    <TextBlock Text="Source Schema" Style="{StaticResource InputLabelStyle}" Margin="0,16,0,6" />
                    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceAltBrush}">
                        <TreeView ItemsSource="{Binding SourceSchema}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Target Definition" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Style="{StaticResource TagPillStyle}" Margin="12,0,0,0">
                            <TextBlock Text="ONLINE" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Connection Type" Style="{StaticResource InputLabelStyle}" />
                    <ComboBox ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding SelectedTargetConnectionType}" Margin="0,0,0,12" />

                    <StackPanel Style="{StaticResource TargetSectionStyle}">
                        <TextBlock Text="API Endpoint URL" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding TargetEndpointUrl}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Authentication" Style="{StaticResource InputLabelStyle}" />
                            <TextBlock Text="Add Header" Style="{StaticResource SubtleTextStyle}" Margin="12,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceAltBrush}">
                            <StackPanel>
                                <TextBlock Text="Bearer Token" Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding TargetBearerToken}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding TargetHeaders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.8*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding Key}" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1" Style="{StaticResource BaseTextBoxStyle}" Text="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Button Content="Call API &amp; Load Schema" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" Command="{Binding LoadTargetSchemaCommand}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource TargetSqlSectionStyle}">
                        <TextBlock Text="Connection String" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding TargetConnectionString}" Margin="0,0,0,12" />
                        <TextBlock Text="Table / View Name" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding TargetTableName}" Margin="0,0,0,12" />
                        <Button Content="Get Schema" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadTargetSchemaCommand}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource TargetCsvSectionStyle}">
                        <TextBlock Text="CSV File" Style="{StaticResource InputLabelStyle}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding TargetCsvPath}" Margin="0,0,12,0" />
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButtonStyle}" />
                        </Grid>
                        <Button Content="Read Headers" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadTargetSchemaCommand}" />
                    </StackPanel>

                    <TextBlock Text="Target Schema" Style="{StaticResource InputLabelStyle}" Margin="0,16,0,6" />
                    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource SurfaceAltBrush}">
                        <ListView ItemsSource="{Binding TargetColumns}" BorderThickness="0" Background="{StaticResource SurfaceAltBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Column Name" DisplayMemberBinding="{Binding Name}" Width="160" />
                                    <GridViewColumn Header="Data Type" DisplayMemberBinding="{Binding DataType}" Width="120" />
                                    <GridViewColumn Header="Req" DisplayMemberBinding="{Binding Required}" Width="50" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
