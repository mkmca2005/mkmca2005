<UserControl x:Class="MapperStudio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatusPillTemplate" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Published">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Testing">
                    <Setter Property="Background" Value="{StaticResource InfoBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SourceTypePillStyle" TargetType="Border" BasedOn="{StaticResource TagPillStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SourceType}" Value="SQL">
                    <Setter Property="Background" Value="{StaticResource TagBlueBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource TagBlueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceType}" Value="REST API">
                    <Setter Property="Background" Value="{StaticResource TagPurpleBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource TagPurpleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceType}" Value="CSV">
                    <Setter Property="Background" Value="{StaticResource TagOrangeBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource TagOrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourceType}" Value="Dataverse">
                    <Setter Property="Background" Value="{StaticResource TagTealBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource TagTealBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <Path Data="M8,10 L28,10 L28,26 L8,26 Z M12,14 L24,14 L24,22 L12,22 Z"
                              Fill="{StaticResource AppBackgroundBrush}"
                              Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="Mapping Studio" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Manage data integration mappings across systems" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Height="28"
                    Width="150"
                    Content="Create Mapping"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CreateNewMappingCommand}"
                    Padding="16,10"
                    Margin="12,4,0,0" />
        </Grid>
        <Border Grid.Row="1" Margin="0,20,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource WatermarkTextBoxStyle}"
                         Tag="Search mappings..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Filters" Style="{StaticResource GhostButtonStyle}" Margin="12,0,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="2">
            <DataGrid ItemsSource="{Binding Mappings}"
                      AutoGenerateColumns="False"
                      Style="{StaticResource DashboardDataGridStyle}"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Name" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RecordCount}" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Source System" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding SourceSystem}" />
                                    <Border Style="{StaticResource SourceTypePillStyle}" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SourceType}" Foreground="{StaticResource AppForegroundBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Target System" Binding="{Binding TargetSystem}" Width="160" />
                    <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="120" />
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusPillTemplate}">
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AppBackgroundBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                    <DataGridTemplateColumn Header="Last Modified" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding UpdatedOn}" />
                                    <TextBlock Text="{Binding UpdatedBy}" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⋯" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
