<Window x:Class="MapperStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:MapperStudio.ViewModels"
        Title="Mapper Studio" Height="900" Width="1400"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource AppForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.DataContext>
        <StaticResource ResourceKey="MainViewModel" />
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                            <Path Data="M6,8 L22,8 L22,20 L6,20 Z M9,11 L19,11 L19,17 L9,17 Z"
                                  Fill="{StaticResource AppBackgroundBrush}"
                                  Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Mapping Studio" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,16,0" />
                        <ContentControl Content="{Binding CurrentView}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type viewModels:SetupViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Setup" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Text=">" Style="{StaticResource SubtleTextStyle}" Margin="6,0" />
                                        <TextBlock Text="Map Fields" Style="{StaticResource SubtleTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Content="{Binding CurrentView}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type viewModels:SetupViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Save Draft" Style="{StaticResource GhostButtonStyle}" Margin="0,0,12,0" Command="{Binding SaveDraftCommand}" />
                                        <Button Content="Next: Map Fields" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NextCommand}" IsEnabled="{Binding CanProceed}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="_" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="✕" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24" />

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding CurrentView}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type viewModels:SetupViewModel}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnectionOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ConnectionStatusText}" Style="{StaticResource SubtleTextStyle}" Margin="0,0,16,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                    <ContentControl Grid.Column="1" Content="{Binding CurrentView}" HorizontalAlignment="Center">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type viewModels:SetupViewModel}">
                                <TextBlock Text="{Binding LastValidationTime}" Style="{StaticResource SubtleTextStyle}" />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                    <ContentControl Grid.Column="2" Content="{Binding CurrentView}" HorizontalAlignment="Right">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type viewModels:SetupViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TargetSystemName}" Style="{StaticResource SubtleTextStyle}" Margin="0,0,16,0" />
                                    <TextBlock Text="{Binding EnvironmentText}" Style="{StaticResource SubtleTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
