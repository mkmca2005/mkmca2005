<Window x:Class="MapperStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapper Studio" Height="900" Width="1400"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource AppForegroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <StaticResource ResourceKey="MainViewModel" />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>           
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
       
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="24" />
    </Grid>
</Window>
