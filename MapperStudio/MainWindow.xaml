<Window x:Class="MapperStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapper Studio" Height="900" Width="1400"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{StaticResource AppForegroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <StaticResource ResourceKey="MainViewModel" />
    </Window.DataContext>
    <Grid>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel Margin="20,0,20,20" VerticalAlignment="Bottom">
                    <TextBlock Text="v1.0" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding CurrentView}" Margin="24" />
    </Grid>
</Window>
