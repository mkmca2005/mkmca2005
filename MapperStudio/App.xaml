<Application x:Class="MapperStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MapperStudio.Views"
             xmlns:viewModels="clr-namespace:MapperStudio.ViewModels"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <viewModels:MainViewModel x:Key="MainViewModel" />
            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SetupViewModel}">
                <views:SetupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SchemaPreviewViewModel}">
                <views:SchemaPreviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:MappingEditorViewModel}">
                <views:MappingEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:StrategyConfigViewModel}">
                <views:StrategyConfigView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ValidationViewModel}">
                <views:ValidationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ExportViewModel}">
                <views:ExportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:DefaultStrategyConfigViewModel}">
                <StackPanel>
                    <TextBlock Text="Default Value Strategy" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Default Type" Style="{StaticResource InputLabelStyle}" />
                        <ComboBox ItemsSource="{Binding DefaultTypes}" SelectedItem="{Binding SelectedDefaultType}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Default Value" Style="{StaticResource InputLabelStyle}" />
                        <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding DefaultValue}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:IfNullStrategyConfigViewModel}">
                <StackPanel>
                    <TextBlock Text="IfNull Strategy" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />
                    <TextBlock Text="Fallback Value" Style="{StaticResource InputLabelStyle}" />
                    <TextBox Style="{StaticResource BaseTextBoxStyle}" Text="{Binding FallbackValue}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TransformStrategyConfigViewModel}">
                <StackPanel>
                    <TextBlock Text="Transform Strategy" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Transform Type" Style="{StaticResource InputLabelStyle}" />
                        <ComboBox ItemsSource="{Binding TransformOptions}" SelectedItem="{Binding SelectedTransform}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Inputs" Style="{StaticResource InputLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding TransformInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:DateFormatStrategyConfigViewModel}">
                <StackPanel>
                    <TextBlock Text="Date Format Strategy" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Input Format" Style="{StaticResource InputLabelStyle}" />
                        <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedInputFormat}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Output Format" Style="{StaticResource InputLabelStyle}" />
                        <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedOutputFormat}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ValueMapStrategyConfigViewModel}">
                <StackPanel>
                    <TextBlock Text="Value Map Strategy" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding Mappings}" AutoGenerateColumns="False" HeadersVisibility="Column" Height="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source Value" Binding="{Binding SourceValue}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Target Value" Binding="{Binding TargetValue}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
